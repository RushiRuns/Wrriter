{
  "name": "wrriter",
  "version": "0.1.0",
  "description": "Wrriter - fast, offline markdown note-taking app",
  "main": "./out/main/index.js",
  "author": "Rushi",
  "license": "MIT",
  "// electron": "Pinned to 42.11.18: latest stable Electron version with matching better-sqlite3 prebuilt binary (ABI 146)",
  "scripts": {
    "build:main": "vite build --config main.vite.config.ts",
    "build:workers": "vite build --config workers.vite.config.ts",
    "build:renderer": "vite build --config renderer.vite.config.ts",
    "build": "npm run build:main && npm run build:workers && npm run build:renderer",
    "dev": "npm run build:main && npm run build:workers && npm run build:renderer && electron .",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --win --dir",
    "check:types": "tsc -b",
    "test:day-one:sqlite": "electron out/main/test-day-one-sqlite.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "electron-builder": "26.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5"
  }
}
