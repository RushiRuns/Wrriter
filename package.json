{
  "name": "wrriter",
  "version": "0.1.0",
  "description": "Wrriter - fast, offline markdown note-taking app",
  "main": "./out/main/index.js",
  "author": "Rushi",
  "license": "MIT",
  "// electron": "Pinned to 42.11.18: latest stable Electron version with matching better-sqlite3 prebuilt binary (ABI 146)",
  "scripts": {
    "// dev": "starts in development mode (depends on the wiring decision; leave as a comment until step 4 is approved)",
    "typecheck": "tsc -b",
    "bundle:main": "vite build --config main.vite.config.ts",
    "bundle:workers": "vite build --config workers.vite.config.ts",
    "bundle:renderer": "vite build --config renderer.vite.config.ts",
    "bundle": "npm run bundle:main && npm run bundle:workers && npm run bundle:renderer",
    "checks:layers": "node scripts/check-rules.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run checks:layers && npm run test",
    "build": "npm run check && npm run bundle && npm run report:size",
    "build:win": "npm run bundle && electron-builder --win",
    "checks:tokens": "node -e \"console.log('TODO')\"",
    "checks:contrast": "node -e \"console.log('TODO')\"",
    "checks:motion": "node -e \"console.log('TODO')\"",
    "checks:dash": "node -e \"console.log('TODO')\"",
    "vault:gen": "node --experimental-strip-types tests/vault-gen/generate-vault.ts",
    "bench": "electron tests/bench/benchmark-suite.mjs",
    "bench:quick": "electron tests/bench/benchmark-suite.mjs --quick",
    "report:size": "node scripts/size-report.mjs",
    "postinstall": "electron-builder install-app-deps",
    "test:day-one:sqlite": "electron out/main/test-day-one-sqlite.js"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "better-sqlite3": "12.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
